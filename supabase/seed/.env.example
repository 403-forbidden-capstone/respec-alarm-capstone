# 시드는 서비스 키로 모든 RLS를 건너뛰어 쓰므로 이 PC의 .env(깃에 안 올라감)에만 둡니다. 팀 카톡방으로 받은 값을 넣어 주세요.
# 프로젝트 주소 (대시보드 → Project Settings → API). dev 프로젝트: https://gomrhctwjvttoqifxktt.supabase.co
SUPABASE_URL=
# service_role 키 (legacy JWT 또는 sb_secret_…) — 절대 앱(EXPO_PUBLIC_)이나 커밋에 넣지 않음
SUPABASE_SERVICE_ROLE_KEY=
# 데모 계정 4개가 함께 쓰는 비밀번호 (8자 이상). 코드에 적지 않고 여기서만 정함
SEED_PASSWORD=
