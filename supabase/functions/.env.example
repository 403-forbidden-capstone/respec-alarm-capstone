# Edge Function 비밀값 — 서버에서만 쓰는 키. 앱 · 레포에 넣지 않음
#
# 로컬에서 함수를 돌릴 때(npx supabase functions serve)만 이 파일을 .env로 복사해 씀
#   cp supabase/functions/.env.example supabase/functions/.env
# 배포된 함수에는 대시보드 → Edge Functions → Secrets 또는 아래 명령으로 넣음
#   npx supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL 같은 Supabase 기본 값은 함수에 자동으로 들어가므로 적지 않음.

# 카카오 디벨로퍼스 → 내 애플리케이션 → 앱 키 → REST API 키 (카카오맵 사용 설정 ON)
# 장소 검색 · 대중교통 길찾기. 응답은 저장 · 재사용 불가(실시간 호출만)
KAKAO_REST_API_KEY=

# Google AI Studio → Get API key
GEMINI_API_KEY=

# (선택) Expo 푸시 보안(Enhanced Security)을 켰을 때만 — expo.dev → 조직 → Access tokens
EXPO_ACCESS_TOKEN=
