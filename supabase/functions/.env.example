# Edge Function 비밀값 — 서버에서만 쓰는 키. 앱 · 레포에 넣지 않음
#
# 로컬에서 함수를 돌릴 때(npx supabase functions serve)만 이 파일을 .env로 복사해 씀
#   cp supabase/functions/.env.example supabase/functions/.env
# 배포된 함수에는 대시보드 → Edge Functions → Secrets 또는 아래 명령으로 넣음 (함수는 다시 배포하지 않아도 바로 읽음)
#   npx supabase@2.119.0 secrets set --env-file supabase/functions/.env --project-ref gomrhctwjvttoqifxktt
#
# SUPABASE_URL · SUPABASE_ANON_KEY · SUPABASE_SERVICE_ROLE_KEY 같은 Supabase 기본 값은 함수에 자동으로 들어가므로 적지 않음
# (이름이 SUPABASE_로 시작하는 비밀값은 직접 만들 수도 없음).

# 카카오 디벨로퍼스 → 내 애플리케이션 → 앱 키 → REST API 키 (카카오맵 사용 설정 ON)
# 쓰는 곳: place-search(로컬 키워드 검색) · alarm-suggest / alarm-commit(대중교통 · 도보 · 자동차 이동시간).
# 응답은 저장 · 재사용 불가(실시간 호출만). 없으면 place-search는 NOT_CONFIGURED, 이동시간은 실측 중앙값 → 직선거리 근사 → 직접 입력으로 넘어감.
# 자동차 길찾기(카카오모빌리티)는 앱의 카카오맵 설정만으로 안 열릴 수 있음 — 카카오모빌리티 쪽 사용 권한 신청을 따로 확인할 것
KAKAO_REST_API_KEY=

# Anthropic Console → API keys  (Claude API — 서버 AI 호출: 대화 답 · 추출 · 일기 · 코칭 · 추천 비서)
# 쓰는 곳: _shared/ai/anthropic.ts (npm:@anthropic-ai/sdk). 부르는 것은 서버 함수뿐이고 앱에는 프롬프트도 키도 없음.
# 없으면 AI 칸만 비고(호출 0번, 앱은 "AI가 지금 답하지 못해요") 알람 · 기록은 그대로 동작함. 로컬 시험(node --test)은 키 없이 가짜 클라이언트로 돔
ANTHROPIC_API_KEY=

# (선택) 쓸 모델 이름. 비우면 실험실에서 실험한 claude-haiku-5-5
# 다른 모델로 바꾸면 단가를 몰라 ai_calls.cost_usd가 NULL로 남음(호출은 그대로 됨) — 단가는 _shared/ai/pricing.ts
ANTHROPIC_MODEL=

# (선택) voice-turn이 ai_calls.io(호출 입력 · 출력 글)를 남길 사용자 id 목록, 쉼표로 구분 — 시드 · 팀 계정용 (L6 안건후보 "대화 기록 보관" 기본안 B)
# 비우면 아무도 안 남김(일반 사용자는 io가 늘 NULL). 개인 정보가 든 글이라 팀 계정만 넣을 것
AI_LOG_IO_USER_IDS=

# Google AI Studio → Get API key  (실시간 음성 대화 — Gemini Live gemini-3.8-live)
# 쓰는 곳: voice-live-token(1회용 토큰만 만들어 앱에 줌) · voice-turn(글 대화 답 · 추출, _shared/ai/gemini.ts). 키 자체는 앱에 가지 않음
GEMINI_API_KEY=

# (선택) voice-turn이 쓸 Gemini 모델. 비우면 Flash-Lite(gemini-3.5-flash-lite)
GEMINI_TEXT_MODEL=

# (선택) 글 대화 사용량 상한 — Google 프로젝트 한도보다 낮게. 0 = 끔, 비우면 같은 기본값(_shared/ai/quota.ts DEFAULT_QUOTA)
#   gemini-3.5-flash-lite 프로젝트 한도(11/6 확인): RPM 15 · TPM 250,000(입력 토큰) · RPD 500 → 보수적으로 아래 값
#   글 대화 · 일정 추출에만 적용. 서버 인스턴스 메모리에서 셈(DB 안 씀 — 인스턴스가 새로 뜨면 0부터). RPD는 최근 24시간 (_shared/ai/quota.ts)
AI_LIMIT_RPM=8
AI_LIMIT_TPM=200000
AI_LIMIT_RPD=300
AI_LIMIT_CONCURRENCY=4
# (선택) 1이면 T2F(추출) ∥ T1(답) 미리 동시 호출 — 답이 빠르지만 일정이 있는 말마다 호출 1번 더. 비우면 차례로(절약)
AI_PARALLEL_PREVIEW=

# (선택) Expo 푸시 보안(Enhanced Security)을 켰을 때만 — expo.dev → 조직 → Access tokens. notify가 읽음
# 푸시가 폰에 도착하려면 Firebase 서비스 계정 키를 EAS credentials에 넣는 것이 따로 필요함 (전체작업계획 2.2)
EXPO_ACCESS_TOKEN=

# CatBoost C1/W4 준비시간 ML sidecar — 기본 꺼짐(0). 코드북/실제 입력 검증 전에는 켜지 말 것.
# 두 함수(alarm-suggest, alarm-commit)는 공통 buildPlan을 거쳐 사용. 실패하면 기존 P80 규칙 유지.
# 클라우드 Supabase에서 Mac의 127.0.0.1:8091에는 접근할 수 없음. 클라우드에는 HTTPS 주소만 지정.
# 서버 키는 EXPO_PUBLIC_* 또는 Git에 올리지 말고 Edge Functions Secret으로 설정.
PREPARE_ML_ENABLED=0
PREPARE_ML_URL=
PREPARE_ML_API_TOKEN=
# 실제 ML 호출에 필요한 서버측 허용 사용자 UUID 목록. 빈 값이면 아무도 모델을 사용하지 못함.
# C1/W4의 원본 범주 코드와 사용자 동의 검증 전에는 채우지 말 것.
PREPARE_ML_ALLOWED_USER_IDS=
# 검증된 2024 조사 코드 매핑 버전. 공식 코드북/동의 흐름 확정 전에는 빈값으로 유지.
PREPARE_ML_CODEBOOK_VERSION=
