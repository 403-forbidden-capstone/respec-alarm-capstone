// 웹 미리보기 — Cloudflare Workers 정적 사이트 설정
// Workers Builds 설정: 경로(Root directory) mobile · 빌드 npm run build:web · 배포 npx wrangler deploy
// name은 Cloudflare 대시보드의 Worker 이름과 같아야 함 (다르면 빌드 실패)
{
  "name": "respec-alarm-capstone",
  "compatibility_date": "2026-10-06",
  "assets": {
    // npm run build:web(expo export)이 만든 폴더. public/ 안의 mockup.html · _headers도 여기로 복사됨
    "directory": "./dist",
    // 없는 주소는 index.html로 → 앱 안 화면 이동(Expo Router)이 새로고침에도 살아 있음
    "not_found_handling": "single-page-application"
  }
}
